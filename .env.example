GIFT_3_PRICE_RUB=
GIFT_4_PRICE_RUB=
GIFT_5_PRICE_RUB=
GIFT_6_PRICE_RUB=
GIFT_7_PRICE_RUB=
GIFT_8_PRICE_RUB=

