GIFT_2_PRICE_USD=0.5
GIFT_3_PRICE_USD=0.5
GIFT_4_PRICE_USD=0.5
GIFT_5_PRICE_USD=0.5
GIFT_6_PRICE_USD=0.5
GIFT_7_PRICE_USD=0.5
GIFT_8_PRICE_USD=0.5

# Telegram MTProto userbot. Never commit real credentials or session files.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USERBOT_SESSION=data/userbot
USERBOT_API_BASE_URL=http://127.0.0.1:8090
USERBOT_API_SECRET=
USERBOT_HOST=127.0.0.1
USERBOT_PORT=8090

# Fragment API v2. FRAGMENT_WALLET_SEED contains 24 words and must stay secret.
FRAGMENT_API_BASE_URL=https://fragment-api.arijitiyan.cc
FRAGMENT_WALLET_SEED=
FRAGMENT_API_TIMEOUT_SECONDS=120
FRAGMENT_PENDING_REVIEW_AGE_SECONDS=30
TONAPI_API_KEY=
TONAPI_BASE_URL=https://tonapi.io
TONAPI_TESTNET=false
TONAPI_TIMEOUT_SECONDS=30
TONAPI_MIN_REQUEST_INTERVAL_MS=1000
TON_WALLET_FEE_RESERVE_NANO=
TON_WALLET_CONFIRM_ATTEMPTS=20
TON_WALLET_CONFIRM_INTERVAL_SECONDS=2
TON_WALLET_RECONCILIATION_INTERVAL_SECONDS=60
TON_WALLET_RECONCILIATION_MIN_AGE_SECONDS=30
FRAGMENT_STARS_API_BASE_URL=https://fragment-api.ydns.eu:8443
FRAGMENT_STARS_API_TIMEOUT_SECONDS=30
FRAGMENT_STARS_PRICE_CACHE_SECONDS=60
FRAGMENT_STARS_MARKUP_PERCENT=0
FRAGMENT_TON_MARKUP_PERCENT=0

# Fallback Stars price and configured prices for products without a price API.
FRAGMENT_STAR_PRICE_USD=
FRAGMENT_PREMIUM_3M_PRICE_USD=13.05
FRAGMENT_PREMIUM_6M_PRICE_USD=17.21
FRAGMENT_PREMIUM_12M_PRICE_USD=29.69
FRAGMENT_TON_PRICE_USD=
FRAGMENT_TON_PRICE_USD_UPDATED_AT=
FRAGMENT_TON_PRICE_USD_MAXIMUM_AGE_SECONDS=86400

# Live TON/USD price source. FRAGMENT_TON_PRICE_USD is used only as fallback.
GECKOTERMINAL_API_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_TON_NETWORK=ton
GECKOTERMINAL_TON_TOKEN_ADDRESS=EQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAM9c
