GECKOTERMINAL_MAX_TON_USD=100
GECKOTERMINAL_MAX_CHANGE_PERCENT=30
TON_RATE_SESSION_TTL_SECONDS=600
TON_PRICE_ADMIN_NOTIFICATION_COOLDOWN_SECONDS=300

